<%- include('../page-parts/head') %> <%- include('../page-parts/header') %>

<main class="container mx-auto p-4 flex-grow">
  <div class="max-w-2xl mx-auto mt-10 bg-white p-6 rounded-lg shadow">
    <div class="flex items-center gap-3 mb-4">
      <div class="text-3xl">⚠️</div>
      <h1 class="text-2xl font-bold"><%= statusCode ? statusCode : 500 %></h1>
    </div>
    <p class="text-gray-700 mb-6">
      <%= message ? message : 'Сталася помилка. Спробуйте ще раз.' %>
    </p>
    <div class="flex gap-3">
      <a
        href="/"
        class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700"
      >
        На головну
      </a>
      <a
        href="/transactions"
        class="bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300"
      >
        До транзакцій
      </a>
    </div>
  </div>
</main>

<%- include('../page-parts/footer') %>
