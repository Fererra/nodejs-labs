<%- include('../page-parts/head') %>
<%- include('../page-parts/header') %>

<main class="container mx-auto p-4 flex-grow">
    <h1 class="text-2xl font-bold mb-6">Список транзакцій</h1>

    <div class="bg-white p-4 rounded-lg shadow mb-6">
        <form action="/transactions" method="GET" class="flex flex-wrap gap-4 items-end">
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700">Тип</label>
                <select name="type" class="border p-2 rounded focus:ring-2 focus:ring-blue-500">
                    <option value="" <%= (typeof query !== 'undefined' && !query.type) ? 'selected' : '' %>>Всі</option>
                    <% if (typeof types !== 'undefined') { %>
                        <% types.forEach(t => { %>
                            <option value="<%= t.name %>" <%= (typeof query !== 'undefined' && query.type === t.name) ? 'selected' : '' %>>
                                <%= t.name === 'income' ? 'Надходження' : 'Витрата' %>
                            </option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700">Категорія</label>
                <select name="category" class="border p-2 rounded focus:ring-2 focus:ring-blue-500 min-w-[150px]">
                    <option value="" <%= (typeof query !== 'undefined' && !query.category) ? 'selected' : '' %>>Всі</option>
                    <% if (typeof categories !== 'undefined') { %>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.name %>" <%= (typeof query !== 'undefined' && query.category === cat.name) ? 'selected' : '' %>>
                                <%= cat.name %>
                            </option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700">Від</label>
                <input 
                    type="date" 
                    name="startDate" 
                    value="<%= (typeof query !== 'undefined' && query.startDate) ? query.startDate : '' %>"
                    class="border p-2 rounded focus:ring-2 focus:ring-blue-500"
                >
            </div>

            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700">До</label>
                <input 
                    type="date" 
                    name="endDate" 
                    value="<%= (typeof query !== 'undefined' && query.endDate) ? query.endDate : '' %>"
                    class="border p-2 rounded focus:ring-2 focus:ring-blue-500"
                >
            </div>

            <div class="flex gap-2">
                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
                    Фільтрувати
                </button>
                <a href="/transactions" class="bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300 transition">
                    Скинути
                </a>
            </div>
        </form>
    </div>

    <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-gray-100 border-b">
                <tr>
                    <th class="p-3">Дата</th>
                    <th class="p-3">Категорія</th>
                    <th class="p-3">Сума</th>
                    <th class="p-3">Назва</th>
                    <th class="p-3">Тип</th>
                    <th class="p-3"></th>
                </tr>
            </thead>
            <tbody>
                <% if (transactions && transactions.length > 0) { %>
                    <% transactions.forEach(item => { %>
                        <tr class="border-b hover:bg-gray-50">
                            <td class="p-3"><%= item.date %></td>
                            <td class="p-3"><%= item.category %></td>
                            
                            <td class="p-3 font-semibold <%= item.type === 'income' ? 'text-green-600' : 'text-red-600' %>">
                                <%= item.amount %> грн
                            </td>
                            
                            <td class="p-3"><%= item.purchase %></td>
                            
                            <td class="p-3 capitalize"><%= item.type === 'income' ? 'Надходження' : 'Витрата' %></td>
                            
                            <td class="p-3 flex items-center gap-4">
                                <a href="/edit/<%= item.id %>" class="text-blue-500 hover:text-blue-700 text-lg" title="Редагувати">✏️</a>
                                
                                <form action="/delete/<%= item.id %>" method="POST" class="m-0" onsubmit="return confirm('Видалити?');">
                                    <button type="submit" class="text-red-500 hover:text-red-700 text-lg" title="Видалити">🗑</button>
                                </form>
                            </td>                            
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="p-3 text-center text-gray-500">Записів за вказаними критеріями не знайдено</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</main>

<%- include('../page-parts/footer') %>