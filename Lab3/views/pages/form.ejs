<%- include('../page-parts/head') %> 
<%- include('../page-parts/header') %>

<main class="container mx-auto p-4 flex-grow">
  <div class="max-w-md mx-auto bg-white p-6 rounded-lg shadow-md">
    <h2 class="text-2xl font-bold mb-6">
      <%= record ? 'Редагувати транзакцію' : 'Додати транзакцію' %>
    </h2>

    <form action="<%= record ? '/edit/' + record.id : '/save' %>" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-medium">Сума</label>
        <input
          type="number"
          name="amount"
          value="<%= record ? record.amount : '' %>"
          required
          class="w-full border rounded p-2 focus:ring-2 focus:ring-blue-500 outline-none"
        />
      </div>
      
      <div>
        <label class="block text-sm font-medium">Назва</label>
        <input
          type="text"
          name="purchase"
          value="<%= record ? record.purchase : '' %>"
          required
          class="w-full border rounded p-2 focus:ring-2 focus:ring-blue-500 outline-none"
        />
      </div>

      <div>
        <label class="block text-sm font-medium">Категорія</label>
        <input
          type="text"
          name="category"
          list="categories-list"
          value="<%= record ? record.category : '' %>"
          placeholder="Почніть вводити або оберіть зі списку..."
          required
          class="w-full border rounded p-2 focus:ring-2 focus:ring-blue-500 outline-none"
        />
        <datalist id="categories-list">
          <% if (typeof categories !== 'undefined') { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.name %>"></option>
            <% }) %>
          <% } %>
        </datalist>
      </div>

      <div>
        <label class="block text-sm font-medium">Тип</label>
        <select name="type" required class="w-full border rounded p-2 focus:ring-2 focus:ring-blue-500 outline-none">
          <option value="" disabled <%= !record ? 'selected' : '' %>>Оберіть тип...</option>
          <% if (typeof types !== 'undefined') { %>
            <% types.forEach(t => { %>
              <option value="<%= t.name %>" <%= record && record.type === t.name ? 'selected' : '' %>>
                <%= t.name === 'income' ? 'Надходження' : 'Витрата' %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <button
        type="submit"
        class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition"
      >
        <%= record ? 'Оновити' : 'Зберегти' %>
      </button>
    </form>
  </div>
</main>

<%- include('../page-parts/footer') %>